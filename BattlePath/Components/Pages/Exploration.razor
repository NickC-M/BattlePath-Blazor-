
@page "/explore"

@using BattlePath.Services
@using BattlePath.Models
@rendermode InteractiveServer
@inject GameStateService GameState
@inject IJSRuntime JS
@inject NavigationManager Nav


<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">




@if (!GameState.InCombat)
{
    
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style=" text-align: left">Exploration  </h2>
        <h2 style=" text-align: right">Floor: <span class="badge badge-warning">@GameState.depth</span></h2>
    </div>
    //<canvas id="exploreBackCanvas" width="1200" height="1200" style="border:2px solid black;"></canvas>
    //exploration canvas
    <canvas id="exploreCanvas" width="800" height="800" style="border:2px solid black;"></canvas>

    <p>Use buttons or WASD keys to move the player:</p>
    <div>
        <button @onclick="() => Move(0, -1)">Up (W)</button>
        <button @onclick="() => Move(-1, 0)">Left (A)</button>
        <button @onclick="() => Move(1, 0)">Right (D)</button>
        <button @onclick="() => Move(0, 1)">Down (S)</button>
    </div>
}
else
{
    <h3>!Combat!</h3>
    //combat GUI
    <div style="display: flex; gap: 20px; align-items: flex-start;">

        <!-- LEFT: COMBAT CANVAS -->
        <div>
            <canvas id="combatCanvas" width="1200" height="720" style="border:1px solid black;"></canvas>

        </div>

        <!-- RIGHT: HUD PANEL -->
        <div style="width: 300px; display: flex; flex-direction: column; gap: 20px;">

            <!-- PLAYER PANEL -->
            <div class="card p-2">
                <h5>Player</h5>

                <div class="progress" style="height: 20px;">
                    <div class="progress-bar bg-success"
                         role="progressbar"
                         style="width:@(GameState.PlayerHealth * 100 / GameState.PlayerMaxHealth)%"
                         aria-valuenow="@GameState.PlayerHealth"
                         aria-valuemin="0"
                         aria-valuemax="@GameState.PlayerMaxHealth">
                        @GameState.PlayerHealth / @GameState.PlayerMaxHealth
                    </div>
                </div>

                <div style="margin-top: 10px;">
                    <div>Max Hp: @GameState.PlayerMaxHealth</div>
                    <div>Attack: @GameState.PlayerAttack</div>
                    <div>Floor: @GameState.depth</div>
                </div>
            </div>

            <!-- ENEMY PANEL -->
            <div class="card p-2">
                <h5>@GameState.CurrentEnemy.Name</h5>
                <div class="progress" style="height: 20px;">
                <div class="progress-bar bg-danger"
                     role="progressbar"
                     style="width:@(GameState.CurrentEnemy.Hp * 100 / GameState.CurrentEnemyMaxHp)%"
                      aria-valuenow="@GameState.CurrentEnemy.Hp"
                      aria-valuemin="0"
                      aria-valuemax="@GameState.CurrentEnemyMaxHp">
                    @GameState.CurrentEnemy.Hp / @GameState.CurrentEnemyMaxHp
                </div>
                </div>
                <div style="margin-top: 10px;">
                    <div>Attack: @GameState.CurrentEnemy.Atk</div> <!--placeholders-->
                    <div>Max Hp: @GameState.CurrentEnemyMaxHp</div>
                </div>
            </div>

            
            <div style="margin-top: 10px;">
                <button @onclick="Attack">Attack</button>
                <button @onclick="Run">Run</button>
            </div>

        </div>
    </div>
}

@code {
    private DotNetObjectReference<Exploration>? objRef;
    private Random rng = new Random();
    private int cEMaxHp = 0;
    protected override void OnInitialized()
    {
        GameState.GenerateRoom();
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("openFullscreen");
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("exploreCanvas.init");
            await JS.InvokeVoidAsync("exploreControls.init", objRef);
            await JS.InvokeVoidAsync("combatCanvas.init");
            await DrawScene();

        }
    }

    [JSInvokable]
    public async Task Move(int dx, int dy)
    {
        int nx = GameState.PlayerX + dx;
        int ny = GameState.PlayerY + dy;
        var nextP = new Position { X = nx, Y = ny };

        //block out of bounds
        if (nx < 0 || nx >= GameState.GridWidth || ny < 0 || ny >= GameState.GridHeight) return;

        if (GameState.IsWaterHere(nextP))
        {
            GameState.PlayerHealth--;
            return;
        }

        GameState.MovePlayer(dx, dy);
        GameState.MoveEnemies();

        if (GameState.IsExitHere())
        {
            GameState.GenerateRoom();
        }else if (GameState.IsEnemyHere())
        {


            GameState.StartCombat();
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("combatCanvas.drawCombat",
    GameState.CurrentEnemy?.IconPath);
        }


        await DrawScene();

    }

    private async Task DrawScene()
    {
        if (!GameState.InCombat)
        {
            foreach (var enemy in GameState.Enemies)
            {
                await JS.InvokeVoidAsync("exploreCanvas.updateEnemyImage", enemy.Id, enemy.IconPath);
            }

            var enemies = GameState.Enemies.Select(e => new
            {
                id = e.Id,
                x = e.X,
                y = e.Y,
                icon = e.IconPath
            });
            await JS.InvokeVoidAsync(
            "exploreCanvas.drawScene",
            GameState.PlayerX,
            GameState.PlayerY,
            enemies,
            GameState.Waters,
            GameState.Exit,
            GameState.GridWidth,
            GameState.GridHeight
            );
            StateHasChanged();
        }
        else if(GameState.InCombat)
        {

            int cEMaxHp = GameState.CurrentEnemy.Hp;

            
            await JS.InvokeVoidAsync("combatCanvas.drawCombat",
    GameState.CurrentEnemy?.IconPath);
            StateHasChanged();
        }

    }

    private async Task Attack()
    {
        GameState.CurrentEnemy.Hp -= GameState.PlayerAttack;

        //animation placeholder
        await JS.InvokeVoidAsync("combatCanvas.attackAnimation");
        await DrawScene();

        if (GameState.CurrentEnemy.Hp <= 0)
        {
            await Task.Delay(1100);
            GameState.EndCombat();
            GameState.Enemies.RemoveAll(e => e.X == GameState.PlayerX && e.Y == GameState.PlayerY);
            await InvokeAsync(StateHasChanged);
            await DrawScene();
            return;
        }

        await EnemyTurn();

        await DrawScene();
    }

    private async Task Run()
    {
        GameState.EndCombat();
        await Move(0, -1);

        await DrawScene();
    }

    private async Task EnemyTurn()
    {
        
        //animation placeholder
        await JS.InvokeVoidAsync("combatCanvas.eAttackAnimation");
        GameState.PlayerHealth -= GameState.CurrentEnemy.Atk;
        if(GameState.PlayerHealth <= 0)
        {

            GameState.EndCombat();
            await InvokeAsync(StateHasChanged);
            GameState.PlayerHealth = 100; //restores health after dying  temp

        }
    }
}
