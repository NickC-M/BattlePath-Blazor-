
@page "/explore"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity;
@attribute [Authorize]
@using BattlePath.Services
@using BattlePath.Models
@using BattlePath.Data
@using System.Text.Json;
@rendermode InteractiveServer
@inject GameStateService GameState
@inject SaveService SaveService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Nav



<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">


<style>

    .levelup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .levelup-box {
        background: white;
        padding: 20px;
        border-radius: 10px;
        text-align: center;
    }

    .choices {
        display: flex;
        gap: 20px;
        justify-content: center;
    }

    .choice {
        cursor: pointer;
        border: 2px solid black;
        padding: 10px;
        transition: 0.2s;
    }

    .choice:hover {
        background: lightgray;
    }

    .levelup-box {
        background: url('/images/table.png') no-repeat center center;
        background-size: contain; /* scale image to cover the box */
        padding: 50px;
        border-radius: 0px;
        text-align: center;
        color: white; /* optional, ensures text is readable */
        box-shadow: 0 0 15px rgba(0,0,0,0.5); /* optional shadow for depth */
    }

</style>

@if (!GameState.InCombat)
{
    
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style=" text-align: left">Exploration  </h2>
        <h2 style=" text-align: right">Floor: <span class="badge badge-warning">@GameState.depth</span></h2>
    </div>
    //<canvas id="exploreBackCanvas" width="1200" height="1200" style="border:2px solid black;"></canvas>
    //exploration canvas
    <div style="display: flex; gap: 20px; align-items: flex-start;">

        <div>
    <canvas id="exploreCanvas" width="800" height="800" style="border:2px solid black;"></canvas>
        </div>
     <!-- RIGHT: HUD PANEL -->
        <div style="width: 300px; display: flex; flex-direction: column; gap: 20px;">

            <!-- PLAYER PANEL -->
            <div class="card p-2">
                <h5>Player</h5>

                <div class="progress" style="height: 20px;">
                    <div class="progress-bar bg-success"
                         role="progressbar"
                         style="width:@(GameState.PlayerHealth * 100 / GameState.PlayerMaxHealth)%"
                         aria-valuenow="@GameState.PlayerHealth"
                         aria-valuemin="0"
                         aria-valuemax="@GameState.PlayerMaxHealth">
                        @GameState.PlayerHealth / @GameState.PlayerMaxHealth
                    </div>
                </div>

                <div style="margin-top: 10px;">
                    <div>Max Hp: @GameState.PlayerMaxHealth</div>
                    <div>Attack: @GameState.PlayerAttack</div>
                    <div>Perma Stats: @GameState.PlayerPerma</div>
                    <div>Level: @GameState.PlayerLvl</div>
                    <div>Exp: @GameState.PlayerExp</div>
                    
                    <div>Floor: @GameState.depth</div>
                </div>
            </div>
    </div>
    <p>Use buttons or WASD keys to move the player:</p>
    <div>
        <button @onclick="() => Move(0, -1)">Up (W)</button>
        <button @onclick="() => Move(-1, 0)">Left (A)</button>
        <button @onclick="() => Move(1, 0)">Right (D)</button>
        <button @onclick="() => Move(0, 1)">Down (S)</button>
    </div>




    </div>

   
}
else
{
    <h3>!Combat!</h3>
    //combat GUI
    <div style="display: flex; gap: 20px; align-items: flex-start;">

        <!-- LEFT: COMBAT CANVAS -->
        <div>
            <canvas id="combatCanvas" width="1200" height="720" style="border:1px solid black;"></canvas>

        </div>

        <!-- RIGHT: HUD PANEL -->
        <div style="width: 300px; display: flex; flex-direction: column; gap: 20px;">

            <!-- PLAYER PANEL -->
            <div class="card p-2">
                <h5>Player</h5>

                <div class="progress" style="height: 20px;">
                    <div class="progress-bar bg-success"
                         role="progressbar"
                         style="width:@(GameState.PlayerHealth * 100 / GameState.PlayerMaxHealth)%"
                         aria-valuenow="@GameState.PlayerHealth"
                         aria-valuemin="0"
                         aria-valuemax="@GameState.PlayerMaxHealth">
                        @GameState.PlayerHealth / @GameState.PlayerMaxHealth
                    </div>
                </div>

                <div style="margin-top: 10px;">
                    <div>Max Hp: @GameState.PlayerMaxHealth</div>
                    <div>Attack: @GameState.PlayerAttack</div>
                    <div>Perma Stats: @GameState.PlayerPerma</div>
                    <div>Level: @GameState.PlayerLvl</div>
                    <div>Exp: @GameState.PlayerExp</div>
                    <div>Floor: @GameState.depth</div>
                </div>
            </div>

            <!-- ENEMY PANEL -->
            <div class="card p-2">
                <h5>@GameState.CurrentEnemy.Name</h5>
                <div class="progress" style="height: 20px;">
                <div class="progress-bar bg-danger"
                     role="progressbar"
                     style="width:@(GameState.CurrentEnemy.Hp * 100 / GameState.CurrentEnemyMaxHp)%"
                      aria-valuenow="@GameState.CurrentEnemy.Hp"
                      aria-valuemin="0"
                      aria-valuemax="@GameState.CurrentEnemyMaxHp">
                    @GameState.CurrentEnemy.Hp / @GameState.CurrentEnemyMaxHp
                </div>
                </div>
                <div style="margin-top: 10px;">
                    <div>Attack: @GameState.CurrentEnemy.Atk</div> 
                    <div>Max Hp: @GameState.CurrentEnemyMaxHp</div>
                    <div>Exp: @GameState.CurrentEnemy.Xp</div>
                </div>
            </div>

            
            <div style="margin-top: 10px;">
                <button @onclick="Attack">Attack</button>
                <button @onclick="Run">Run</button>
            </div>


            

        </div>
    </div>
}

@if (showLevelUp)
{
    <div class="card p-2">
        <div class="levelup-overlay">
            <div class="levelup-box">
                <h3>Level Up!</h3>
                <p>Choose an upgrade:</p>

                <div class="choices">
                    <div class="choice" @onclick="ChooseAttack">
                        <img src="images/sword.png" width="100" />
                        <p>+1 Attack</p>
                    </div>

                    <div class="choice" @onclick="ChooseHealth">
                        <img src="images/meat.png" width="100" />
                        <p>+5 Max HP</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}



@code {
    private bool showLevelUp = false;
    private DotNetObjectReference<Exploration>? objRef;
    private Random rng = new Random();
    private int cEMaxHp = 0;
    protected override async Task OnInitializedAsync()
    {
        await LoadGame();
        if (GameState.depth == 0)
        {
            GameState.GenerateRoom();
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("openFullscreen");
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("exploreCanvas.init");
            await JS.InvokeVoidAsync("exploreControls.init", objRef);
            await JS.InvokeVoidAsync("combatCanvas.init");
            await DrawScene();

        }
    }

    [JSInvokable]
    public async Task Move(int dx, int dy)
    {
        if (showLevelUp) return;
        if (GameState.PlayerExp >= 10)
        {
            GameState.PlayerLvl++;
            GameState.PlayerExp -= 10;
            await JS.InvokeVoidAsync("playSound", "sounds/levelup.mp3");
            showLevelUp = true;
        }
        int nx = GameState.PlayerX + dx;
        int ny = GameState.PlayerY + dy;
        var nextP = new Position { X = nx, Y = ny };

        //block out of bounds
        if (nx < 0 || nx >= GameState.GridWidth || ny < 0 || ny >= GameState.GridHeight) return;

        if (GameState.IsWaterHere(nextP))
        {
            GameState.PlayerHealth--;
            return;
        }

        GameState.MovePlayer(dx, dy);
        GameState.MoveEnemies();

        if (GameState.IsExitHere())
        {
            await JS.InvokeVoidAsync("playSound", "sounds/good.wav");
            GameState.GenerateRoom();
        }else if (GameState.IsEnemyHere())
        {


            GameState.StartCombat();
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("combatCanvas.drawCombat",
    GameState.CurrentEnemy?.IconPath);
        }


        await DrawScene();

    }

    private async Task DrawScene()
    {
        if (!GameState.InCombat)
        {
            foreach (var enemy in GameState.Enemies)
            {
                await JS.InvokeVoidAsync("exploreCanvas.updateEnemyImage", enemy.Id, enemy.IconPath);
            }

            var enemies = GameState.Enemies.Select(e => new
            {
                id = e.Id,
                x = e.X,
                y = e.Y,
                icon = e.IconPath
            });
            await JS.InvokeVoidAsync(
            "exploreCanvas.drawScene",
            GameState.PlayerX,
            GameState.PlayerY,
            enemies,
            GameState.Waters,
            GameState.Exit,
            GameState.GridWidth,
            GameState.GridHeight
            );
            StateHasChanged();
        }
        else if(GameState.InCombat)
        {

            int cEMaxHp = GameState.CurrentEnemy.Hp;


            await JS.InvokeVoidAsync("combatCanvas.drawCombat",
    GameState.CurrentEnemy?.IconPath);
            StateHasChanged();
        }

    }

    private async Task Attack()
    {
        if (showLevelUp) return;
        GameState.CurrentEnemy.Hp -= GameState.PlayerAttack;

        //animation placeholder
        await JS.InvokeVoidAsync("combatCanvas.attackAnimation");
        await JS.InvokeVoidAsync("playSound", "sounds/swordslash2.mp3");
        await DrawScene();

        if (GameState.CurrentEnemy.Hp <= 0)
        {
            await Task.Delay(1100);
            GameState.PlayerExp += GameState.CurrentEnemy.Xp;
            if(GameState.PlayerExp >= 10)
            {
                GameState.PlayerLvl++;
                GameState.PlayerExp -= 10;
                await JS.InvokeVoidAsync("playSound", "sounds/levelup.mp3");
                showLevelUp = true;

            }
            GameState.Enemies.RemoveAll(e => e.X == GameState.PlayerX && e.Y == GameState.PlayerY);
            await EndCombatAndSave();

            await InvokeAsync(StateHasChanged);
            await DrawScene();
            return;
        }

        await EnemyTurn();

        await DrawScene();
    }

    private async Task Run()
    {
        await EndCombatAndSave();
        await Move(0, -1);

        await DrawScene();
    }

    private async Task EnemyTurn()
    {
        //enemy animation
        await Task.Delay(1200);
        await JS.InvokeVoidAsync("combatCanvas.eAttackAnimation");
        await JS.InvokeVoidAsync("playSound", "sounds/hurt.wav");
        GameState.PlayerHealth -= GameState.CurrentEnemy.Atk;
        if(GameState.PlayerHealth <= 0)
        {
            GameState.PlayerDeath();
            await EndCombatAndSave();
            await InvokeAsync(StateHasChanged);
            

        }
    }

    private async Task SaveGame()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user == null) return;

        var save = SaveService.CreateSave(GameState);

        user.SaveDataJson = JsonSerializer.Serialize(save);

        await UserManager.UpdateAsync(user);
    }

    private async Task EndCombatAndSave()
    {
        GameState.EndCombat();
        await SaveGame();
    }

    private async Task LoadGame()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user == null) return;

        if (string.IsNullOrEmpty(user.SaveDataJson))
            return; //no save yet

        var save = JsonSerializer.Deserialize<Save>(user.SaveDataJson);

        if (save != null)
        {
            SaveService.LoadSave(save, GameState);
        }
    }


    private void ChooseAttack()
    {
        GameState.PlayerAttack += 1;
        showLevelUp = false;
    }

    private void ChooseHealth()
    {
        GameState.PlayerMaxHealth += 5;
        GameState.PlayerHealth += 5;
        showLevelUp = false;
    }
}
