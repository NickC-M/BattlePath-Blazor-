@page "/explore"
@using BattlePath.Services
@rendermode InteractiveServer
@inject GameStateService GameState
@inject IJSRuntime JS
@inject NavigationManager Nav


<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">




@if (!GameState.InCombat)
{
    
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style=" text-align: left">Exploration  </h2>
        <h2 style=" text-align: right">Floor: <span class="badge badge-warning">@GameState.depth</span></h2>
    </div>
    //exploration canvas
    <canvas id="exploreCanvas" width="1200" height="800" style="border:2px solid black;"></canvas>

    <p>Use buttons or WASD keys to move the player:</p>
    <div>
        <button @onclick="() => Move(0, -1)">Up (W)</button>
        <button @onclick="() => Move(-1, 0)">Left (A)</button>
        <button @onclick="() => Move(1, 0)">Right (D)</button>
        <button @onclick="() => Move(0, 1)">Down (S)</button>
    </div>
}
else
{
    <h3>!Combat!</h3>
    //combat GUI
    <div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
        <canvas id="combatCanvas" width="1200" height="720" style="border:1px solid black;"></canvas>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 style=" text-align: left">Player HP: <span class="badge badge-success">@GameState.PlayerHealth</span></h2>
            <h2 style=" text-align: right">Enemy HP: <span class="badge badge-danger">@GameState.EnemyHealth</span></h2>
        </div>
        <button @onclick="Attack">Attack</button>
        <button @onclick="Run">Run</button>
    </div>
}

@code {
    private DotNetObjectReference<Exploration>? objRef;
    private Random rng = new Random();
    protected override void OnInitialized()
    {
        GameState.GenerateRoom();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("exploreCanvas.init");
            await JS.InvokeVoidAsync("exploreControls.init", objRef);
            await JS.InvokeVoidAsync("combatCanvas.init");
            await DrawScene();

        }
    }

    [JSInvokable]
    public async Task Move(int dx, int dy)
    {
        int tx = GameState.PlayerX;
        int ty = GameState.PlayerY;


        if (!GameState.MovePlayer(dx, dy)) return;

        if (GameState.IsExitHere())
        {
            GameState.GenerateRoom();
        }
        else if (GameState.IsEnemyHere())
        {
            GameState.StartCombat();
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("combatCanvas.drawCombat");

        }

        if (GameState.IsWaterHere())
        {
            GameState.PlayerHealth--;
            if(!GameState.MovePlayer(tx, ty)) return;
        }

        await DrawScene();

    }

    private async Task DrawScene()
    {
        if (!GameState.InCombat)
        {
            await JS.InvokeVoidAsync(
            "exploreCanvas.drawScene",
            GameState.PlayerX,
            GameState.PlayerY,
            GameState.Enemies,
            GameState.Waters,
            GameState.Exit,
            GameState.GridWidth,
            GameState.GridHeight
            );
            StateHasChanged();
        }
        else if(GameState.InCombat)
        {
            await JS.InvokeVoidAsync("combatCanvas.drawCombat");
            StateHasChanged();
        }

    }

    private async Task Attack()
    {
        GameState.EnemyHealth -= GameState.PlayerAttack;

        //animation placeholder
        await JS.InvokeVoidAsync("combatCanvas.attackAnimation");


        if (GameState.EnemyHealth <= 0)
        {
            GameState.EndCombat();
            GameState.Enemies.RemoveAll(e => e.X == GameState.PlayerX && e.Y == GameState.PlayerY);
            await DrawScene();
        }
        
        await EnemyTurn();

        await DrawScene();
    }

    private async Task Run()
    {
        GameState.EndCombat();
        await Move(0, -1);

        await DrawScene();
    }

    private async Task EnemyTurn()
    {
        GameState.PlayerHealth -= 5;
        //animation placeholder
        await JS.InvokeVoidAsync("combatCanvas.eAttackAnimation");
        if(GameState.PlayerHealth <= 0)
        {
            GameState.EndCombat();
            
        }
    }
}